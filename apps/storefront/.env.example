NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_STORE_NAME=
# Cloudflare Turnstile PUBLIC site key (the secret key goes only into Supabase Edge Function secrets).
# Required in production. For local testing Cloudflare publishes a test key: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional: store WhatsApp number in international format (digits only). Shows a floating chat button.
NEXT_PUBLIC_WHATSAPP=
